# T-2CAN FD (ESP32-S3) sdkconfig. Standalone on purpose: the C6 env keeps
# using sdkconfig.defaults only, so this file is not merged into that build.
# Shared options below are copied from sdkconfig.defaults. If you change a
# shared option there, change it here too.
#
# Flash / PSRAM follow the LilyGo wiki and the T-2Can README (ESP32-S3-WROOM-1U
# MCN16R8, 16 MB flash, 8 MB OPI PSRAM, QIO 80 MHz). The schematic symbol is
# labeled N8R8; treat that as a library-symbol mismatch until a board is read
# back with esptool flash_id.

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set

CONFIG_ESP_PARTITION_TABLE_CUSTOM=y
CONFIG_ESP_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16mb.csv"

# CONFIG_ESPTOOLPY_FLASHSIZE_2MB is not set
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
# CONFIG_ESPTOOLPY_FLASHSIZE_8MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# 8 MB octal PSRAM (OPI) on the WROOM-1 module.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=16384
# CONFIG_BT_NIMBLE_SM_LEGACY is not set

CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y
# CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT is not set

CONFIG_BT_NIMBLE_LOG_LEVEL_INFO=y
# CONFIG_BT_NIMBLE_LOG_LEVEL_INFO is not set

CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# BLE under trace load (see protocol.c trace_flush). Host buffers stay in
# internal RAM (safest for the VHCI path); with batched trace 16/24 is plenty.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=16
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=24

# ---- Internal-RAM budget --------------------------------------------------
# The BT controller allocates from internal RAM at runtime; in 240d1ab only
# ~17 KB were left with BLE connected. Everything that does not need
# internal RAM goes to the 8 MB PSRAM:
#  - malloc() >= 1 KB goes to PSRAM (was 16 KB: nearly every allocation
#    landed in internal RAM). Explicit heap_caps(INTERNAL/DMA) users - BT
#    controller, NimBLE, FreeRTOS objects, TWAI/SPI/USJ drivers - are not
#    affected; the 32 KB internal reserve pool stays for them.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
#  - large task-only static buffers marked DORKY_EXT_BSS (board/ext_ram.h)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
#  - WiFi/LWIP buffers in PSRAM where possible; WiFi itself only starts when
#    credentials exist (wifi.c). Fewer static RX/TX buffers (each ~1.6 KB
#    internal), and WiFi hot paths in flash instead of IRAM (~15 KB more
#    heap; WiFi is only used for the file server).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
